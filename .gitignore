# ---- Python / backend ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/

# Backend runtime data (generated at runtime — keep default config.json only)
backend/data/*.db
backend/data/*.db-journal
backend/existing/data/history.csv
backend/existing/data/app.log
backend/existing/data/exported_passwords.*
backend/static/exports/*
!backend/static/exports/.gitkeep

# ---- Environment files (never commit real secrets) ----
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
*.local

# ---- Editors / OS ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
